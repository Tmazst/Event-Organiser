SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///event_organiser.db
SESSION_COOKIE_NAME=event_organiser_session_v2
SESSION_COOKIE_SECURE=true

# Pricing rules
FREE_BUDGET_ITEM_LIMIT=4
OWNER_PLAN_PRICE=40.00
STAKEHOLDER_PRICE=30.00

# Shared vendor service
VENDOR_FEATURE_ENABLED=true
VENDOR_STORE_MANAGEMENT_ENABLED=true
VENDOR_API_ENABLED=enabled
VENDOR_ACCOUNT_API_ENABLED=enabled
VENDOR_API_KEY=api-key-will-be-generated-on-later-09-2026

# Signed login handoff between Umcimby and UMSHADO.
# Use the exact same SHARED_LOGIN_SECRET in both applications.
SHARED_LOGIN_HANDOFF_ENABLED=false
SHARED_LOGIN_SECRET=
SHARED_LOGIN_MAX_AGE_SECONDS=90
UMSHADO_SSO_RECEIVE_URL=https://wedding.quickmessanger.com/shared-login/from-umcimby

# MojaPOS / MTN MoMo
MOJAPOS_API_URL=https://mojapos.com/api
MOJAPOS_API_KEY=
MOJAPOS_WEBHOOK_SECRET=
MOJAPOS_VERIFY_WEBHOOK_SIGNATURE=false
MOJAPOS_PROVIDER=MTN_MOMO
MOJAPOS_CURRENCY=SZL
MOJAPOS_SUPPORTED_COUNTRIES=SZ
MOJAPOS_INITIATE_PATH=/payments/pay
MOJAPOS_CALLBACK_PATH=/api/payment/callback

# Local proofing only. Set both to false in production.
MOJAPOS_MOCK_MODE=true
MOJAPOS_MOCK_AUTO_COMPLETE=true
